{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-room3d.local/contracts/demo-snapshot.v1.schema.json",
  "title": "War-Room3D M0 demonstration snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "sectorId", "selectedProjectId", "projects"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "mode": { "const": "demo" },
    "sectorId": { "const": "setor-01" },
    "selectedProjectId": { "type": "string", "minLength": 1 },
    "projects": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "name", "slotId", "provider", "activeAgents", "status", "activity"],
        "properties": {
          "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "slotId": { "type": "string", "enum": ["slot-01", "slot-02", "slot-03", "slot-04", "slot-05", "slot-06"] },
          "provider": { "type": "string", "enum": ["Codex", "Claude", "Ambos"] },
          "activeAgents": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["trabalhando", "aguardando", "atencao", "inativo"] },
          "activity": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    }
  }
}
