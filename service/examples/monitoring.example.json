{
  "schemaVersion": "1.0",
  "projects": [
    {
      "projectId": "project-example",
      "name": "Projeto ilustrativo",
      "canonicalPath": "C:\\Projects\\example"
    }
  ],
  "inventory": {
    "schemaVersion": "1.0",
    "environments": [
      { "environmentId": "local-example", "name": "Ambiente ilustrativo" }
    ],
    "resources": [
      {
        "resourceId": "host-example",
        "environmentId": "local-example",
        "kind": "host",
        "name": "Host local",
        "sourceId": "probe-host-example",
        "staleAfterMs": 30000
      },
      {
        "resourceId": "api-example",
        "environmentId": "local-example",
        "kind": "api",
        "name": "API Docker (exemplo)",
        "sourceId": "probe-api-example",
        "staleAfterMs": 120000
      }
    ],
    "projectResources": [
      {
        "projectId": "project-example",
        "resourceId": "host-example",
        "origin": "configured",
        "confidence": "unverified"
      },
      {
        "projectId": "project-example",
        "resourceId": "api-example",
        "origin": "configured",
        "confidence": "unverified"
      }
    ],
    "dependencies": []
  },
  "probes": [
    { "kind": "host", "resourceId": "host-example" }
  ],
  "intervalMs": 5000,
  "timeoutMs": 1000,
  "m5NetworkSignals": false,
  "m5DockerLogs": {
    "enabled": false,
    "composeProject": "compose-example",
    "composeWorkingDir": "C:\\Projects\\example\\infra\\docker",
    "service": "api",
    "environmentId": "local-example",
    "resourceId": "api-example",
    "retentionDays": 1,
    "initialLookbackMinutes": 60,
    "intervalMs": 60000
  },
  "m5Rules": []
}
