<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="surface" class="surface" picking-mode="Ignore">
        <ui:VisualElement name="header" class="header">
            <ui:Label name="stage-eyebrow" text="WAR-ROOM3D · DEMONSTRAÇÃO" class="eyebrow" />
            <ui:Label name="breadcrumb" text="Quartel / Setor 01" class="heading" />
            <ui:Label name="demo-seal" text="CONCEITO · DADOS ILUSTRATIVOS" class="seal" />
        </ui:VisualElement>
        <ui:VisualElement name="overview" class="overview" picking-mode="Ignore">
            <ui:VisualElement name="overview-heading" class="overview-heading">
                <ui:Label name="overview-sector" text="SETOR 01   /   VISÃO DE OPERAÇÕES" class="overview-kicker" />
                <ui:Label text="Projetos do setor" class="overview-title" />
                <ui:Label name="overview-service" class="overview-meta" />
                <ui:Label name="overview-source" class="overview-meta" />
                <ui:TextField name="overview-search" label="Buscar projeto" class="overview-search" />
                <ui:ScrollView name="overview-search-results" class="overview-search-results" />
            </ui:VisualElement>
            <ui:VisualElement name="overview-actions" class="overview-actions">
                <ui:Button name="overview-center" text="Data center" class="overview-tool" />
                <ui:Button name="overview-tools" text="Câmera e ações" class="overview-tool" />
            </ui:VisualElement>
            <ui:VisualElement name="overview-dock" class="overview-dock">
                <ui:Label name="overview-empty" text="Aguardando projetos do serviço local." class="overview-meta" />
                <ui:ScrollView name="overview-scroll" mode="Horizontal" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Auto">
                    <ui:VisualElement name="overview-cards" class="overview-cards" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="effect-banner" text="" class="effect-banner" />
        <ui:Label name="room-label" text="SELECIONE UMA SALA" class="room-label" />
        <ui:Button name="summary-toggle" text="Recolher resumo" class="summary-toggle" />
        <ui:VisualElement name="project-panel" class="project-panel">
          <ui:VisualElement name="project-content" class="project-content">
            <ui:Label name="view-title" text="Salas do setor" class="section-title" />
            <ui:VisualElement name="room-summary">
              <ui:Label name="project-list-heading" text="PROJETOS DO SETOR" class="eyebrow section-space" />
              <ui:ScrollView name="project-list" class="project-list" />
              <ui:Label text="SALA SELECIONADA" class="eyebrow section-space" />
              <ui:Label name="project-name" text="API Core" class="project-name" />
              <ui:Label name="status" text="● Trabalhando · exemplo" class="status" />
              <ui:VisualElement class="detail-row"><ui:Label text="Provedor" /><ui:Label name="provider" text="Ambos" /></ui:VisualElement>
              <ui:VisualElement class="detail-row"><ui:Label text="Agentes" /><ui:Label name="agents" text="4 agentes ilustrativos" /></ui:VisualElement>
              <ui:Button name="enter-button" text="Entrar na sala" class="primary-button" />
              <ui:Button name="center-button" text="Abrir data center" class="secondary-button" />
            </ui:VisualElement>
            <ui:VisualElement name="agent-list-section" class="agent-list-section">
              <ui:Label name="agents-heading" text="AGENTES ILUSTRATIVOS" class="eyebrow section-space" />
              <ui:ScrollView name="agent-list" class="agent-list" />
              <ui:Label name="agent-empty" text="○ Nenhum agente observado nesta sala" class="hint" />
            </ui:VisualElement>
            <ui:VisualElement name="room-tabs" class="room-tabs">
              <ui:Button name="tab-activity" text="● Atividade" />
              <ui:Button name="tab-chat" text="○ Chat" />
              <ui:Button name="tab-logs" text="○ Logs" />
              <ui:Button name="tab-sources" text="○ Fontes" />
            </ui:VisualElement>
            <ui:Button name="expand-toggle" text="Ampliar leitura" class="secondary-button" />
            <ui:ScrollView name="room-content" class="room-content">
              <ui:VisualElement name="page-activity">
                <ui:Label name="selected-agent" text="Selecione agente" class="hint" />
                <ui:Label name="activity-heading" text="ATIVIDADE ILUSTRATIVA" class="eyebrow section-space" />
                <ui:Label name="activity" text="Atividade indisponível" class="activity" />
                <ui:Label name="agent-tree" text="" class="activity" />
                <ui:Button name="evidence-open" text="Ver detalhe da evidência" class="secondary-button" />
                <ui:Button name="chat-open-agent" text="Abrir chat desta sessão" class="secondary-button" />
              </ui:VisualElement>
              <ui:VisualElement name="page-chat">
                <ui:Label name="chat-title" text="CHAT · SESSÃO SELECIONADA" class="eyebrow section-space" />
                <ui:Label name="chat-scope" text="Selecione um agente observado." class="hint" />
                <ui:Label name="chat-status" text="Histórico ainda não consultado." class="activity" />
                <ui:VisualElement name="chat-messages" class="chat-messages" />
                <ui:Button name="chat-more" text="Carregar mensagens anteriores" class="secondary-button" />
                <ui:Button name="chat-refresh" text="Atualizar histórico" class="secondary-button" />
                <ui:Button name="chat-interact" text="Escrever / revisar intenção" class="primary-button" />
                <ui:Button name="chat-delete" text="Excluir histórico desta sessão" class="secondary-button" />
                <ui:Label text="Histórico observado e comando são trilhas distintas. Recibo de envio não comprova resposta do agente." class="hint" />
              </ui:VisualElement>
              <ui:VisualElement name="page-logs">
                <ui:Label name="feed-heading" text="LOGS E EVIDÊNCIAS" class="eyebrow section-space" />
                <ui:Label name="feed" text="Sem eventos" class="hint" />
                <ui:Label name="log-scope" text="Selecione um projeto." class="hint" />
                <ui:DropdownField name="log-category" label="Categoria" />
                <ui:Button name="log-filter-toggle" text="Mostrar filtros adicionais" class="secondary-button" />
                <ui:VisualElement name="log-filters" class="log-filters">
                  <ui:Toggle name="log-agent-filter" label="Somente agente selecionado" />
                  <ui:DropdownField name="log-environment" label="Ambiente" />
                  <ui:DropdownField name="log-resource" label="Recurso" />
                  <ui:DropdownField name="log-severity" label="Severidade" />
                  <ui:TextField name="log-from" label="De (UTC ISO 8601)" />
                  <ui:TextField name="log-to" label="Até (UTC ISO 8601)" />
                  <ui:TextField name="log-request" label="Request ID explícito" />
                </ui:VisualElement>
                <ui:Button name="log-query" text="Consultar logs" class="primary-button" />
                <ui:Label name="log-status" text="Consulta pendente." class="hint" />
                <ui:VisualElement name="log-results" class="log-results" />
                <ui:Button name="log-more" text="Carregar página anterior" class="secondary-button" />
                <ui:Button name="log-refresh" text="Atualizar página recente" class="secondary-button" />
                <ui:Label text="Sem fonte = sem cobertura. Logs de infraestrutura sem sessão não recebem agente por aproximação temporal." class="hint" />
              </ui:VisualElement>
              <ui:VisualElement name="page-sources">
                <ui:Label text="FONTES E INFRAESTRUTURA" class="eyebrow section-space" />
                <ui:Label name="infrastructure-alert" text="Sem dados de infraestrutura" class="activity" />
                <ui:Label name="source-session-status" text="Selecione um agente para consultar a fonte da sessão." class="activity" />
                <ui:Label text="○ Estado do hook e cobertura por fonte: indisponíveis nesta fatia." class="hint" />
              </ui:VisualElement>
            </ui:ScrollView>
            <ui:Button name="back-button" text="Voltar ao quartel" class="primary-button" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="evidence-detail" class="evidence-detail">
          <ui:Label text="DETALHE DA EVIDÊNCIA" class="eyebrow" />
          <ui:ScrollView name="evidence-scroll"><ui:Label name="evidence-body" text="Selecione agente para consultar último sinal." class="activity" /></ui:ScrollView>
          <ui:Button name="evidence-close" text="Fechar detalhe" class="primary-button" />
        </ui:VisualElement>
        <ui:VisualElement name="resource-panel" class="project-panel resource-panel">
          <ui:ScrollView class="project-content">
            <ui:Label text="Quartel-general / Data center" class="eyebrow" />
            <ui:Label text="Recursos e dependências" class="section-title" />
            <ui:Label name="resource-filter" text="Filtro: todos os recursos" class="hint" />
            <ui:Button name="resource-project-button" text="Desta sala" class="primary-button" />
            <ui:Button name="resource-all-button" text="Todos os recursos" class="primary-button" />
            <ui:Label name="resource-list-heading" text="RECURSOS · EXEMPLO" class="eyebrow section-space" />
            <ui:ScrollView name="resource-list" class="project-list" />
            <ui:Label text="RECURSO SELECIONADO" class="eyebrow section-space" />
            <ui:Label name="resource-name" text="Selecione um recurso" class="project-name" />
            <ui:Label name="resource-status" text="Sem dados · exemplo" class="status" />
            <ui:Label name="resource-detail" text="" class="activity" />
            <ui:Button name="operations-open-button" text="Logs, rede e segurança" class="primary-button operations-open-button" />
            <ui:Button name="resource-back-button" text="Voltar ao quartel" class="primary-button" />
          </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="control-panel" class="control-panel">
            <ui:Label text="CÂMERA" class="eyebrow" />
            <ui:Button name="angle-button" text="Outro ângulo" />
            <ui:Button name="reset-button" text="Restaurar câmera" />
            <ui:Button name="history-button" text="Meu dia / histórico" class="history-button" />
            <ui:Button name="command-button" text="Interação assistida" class="command-button" />
            <ui:Button name="effects-toggle" text="Reduzir efeitos: não" class="effects-toggle" />
            <ui:Label text="Mouse direito: girar  ·  Roda: zoom" class="hint" />
        </ui:VisualElement>
        <ui:VisualElement name="history-mask" class="history-mask" />
        <ui:VisualElement name="history-panel" class="history-panel">
            <ui:Label name="history-seal" text="MEU DIA · LEITURA" class="history-seal" />
            <ui:Label text="Meu dia" class="history-title" />
            <ui:TextField name="history-date" label="Data (AAAA-MM-DD)" />
            <ui:TextField name="history-zone" label="Fuso IANA" />
            <ui:DropdownField name="history-project" label="Projeto" />
            <ui:Button name="history-load" text="Consultar dia" class="primary-button" />
            <ui:Label name="history-metrics" text="Selecione data e fuso." class="activity" />
            <ui:Label name="history-coverage" text="Cobertura ainda não consultada." class="hint" />
            <ui:ScrollView name="history-timeline" class="history-timeline" />
            <ui:Button name="history-replay" text="Abrir histórico completo" class="primary-button" />
            <ui:VisualElement name="history-replay-controls" class="history-replay-controls">
                <ui:Button name="history-previous" text="Anterior" />
                <ui:Button name="history-next" text="Próximo" />
                <ui:Button name="history-live" text="Voltar ao vivo" />
            </ui:VisualElement>
            <ui:VisualElement name="history-time-controls" class="history-time-controls">
                <ui:TextField name="history-seek" label="Instante UTC (AAAA-MM-DDTHH:MM:SSZ)" />
                <ui:VisualElement class="history-time-actions">
                    <ui:Button name="history-seek-button" text="Buscar instante" />
                    <ui:Button name="history-play" text="Reproduzir" />
                    <ui:Button name="history-speed" text="1×" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="history-close" text="Fechar" />
        </ui:VisualElement>
        <ui:VisualElement name="operations-mask" class="history-mask" />
        <ui:VisualElement name="operations-panel" class="operations-panel">
            <ui:Label text="M5 · OPERAÇÃO AMPLIADA" class="history-seal" />
            <ui:Label text="Sinais e incidentes" class="history-title" />
            <ui:Label name="operations-limit" text="Consultas apenas nas fontes autorizadas e registradas."
                      class="hint" />
            <ui:TextField name="operations-environment" label="Ambiente" />
            <ui:TextField name="operations-project" label="Projeto (opcional)" />
            <ui:TextField name="operations-resource" label="Recurso (opcional)" />
            <ui:TextField name="operations-from" label="Desde UTC" />
            <ui:TextField name="operations-to" label="Até UTC" />
            <ui:TextField name="operations-trace" label="Trace ID / Request ID" />
            <ui:DropdownField name="operations-category" label="Fonte" />
            <ui:DropdownField name="operations-severity" label="Severidade" />
            <ui:VisualElement class="operations-actions">
                <ui:Button name="operations-sources" text="Cobertura" />
                <ui:Button name="operations-query" text="Consultar sinais" />
                <ui:Button name="operations-incidents" text="Incidentes" />
            </ui:VisualElement>
            <ui:Button name="operations-next" text="Próxima página" />
            <ui:Label name="operations-status" text="Selecione ambiente e consulte cobertura." class="hint" />
            <ui:ScrollView name="operations-results" class="operations-results" />
            <ui:Button name="operations-close" text="Fechar" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
